<!DOCTYPE html>
<html lang="en">
<%- include('partials/head', {title: 'Home – SocialNode' }) %>

  <body class="bg-[#0b0c10] text-[#c5c6c7] antialiased">

    <%- include('partials/navbar') %>

      <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-8">

          <!-- Left Column: Profile Card & Quick Navigation (lg:col-span-4) -->
          <aside class="lg:col-span-4 space-y-6 lg:sticky lg:top-24 h-fit">
            <!-- Profile summary card -->
            <div class="glass rounded-3xl overflow-hidden">
              <div class="h-24 bg-gradient-to-r from-blue-600 to-indigo-600"></div>
              <div class="px-6 pb-6 -mt-12 text-center">
                <img src="/images/uploads/<%= (user && user.profilepic) ? user.profilepic : 'default.jpg' %>"
                  alt="Avatar"
                  class="w-24 h-24 rounded-3xl object-cover mx-auto border-4 border-[#0b0c10] bg-[#0b0c10] shadow-xl" />
                <h1 class="mt-4 text-xl font-bold text-white">
                  <%= user.name || 'User' %>
                </h1>
                <p class="text-zinc-500 text-sm">@<%= user.username %>
                </p>

                <div class="mt-6 pt-6 border-t border-white/5 flex justify-center gap-8">
                  <div>
                    <span class="block text-white font-bold">
                      <%= user.posts ? user.posts.length : 0 %>
                    </span>
                    <span class="text-[10px] uppercase tracking-widest text-zinc-500 font-bold">Posts</span>
                  </div>
                  <div>
                    <span class="block text-white font-bold">0</span>
                    <span class="text-[10px] uppercase tracking-widest text-zinc-500 font-bold">Followers</span>
                  </div>
                </div>

                <a href="/profile/upload"
                  class="mt-8 block w-full bg-white/5 hover:bg-white/10 text-white text-xs font-bold py-3 rounded-xl transition-all border border-white/10 uppercase tracking-widest text-center">
                  Update Identity
                </a>
              </div>
            </div>

            <!-- Navigation / Content Switching -->
            <div class="glass rounded-3xl p-3 space-y-1">
              <h2 class="text-[10px] uppercase tracking-[0.2em] font-bold text-zinc-600 px-4 pt-2 mb-2">Shortcuts</h2>
              <a href="/profile"
                class="flex items-center gap-3 px-4 py-3 bg-blue-600/10 border border-blue-500/20 text-white rounded-2xl transition-all group">
                <svg class="w-5 h-5 text-blue-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                    d="M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 13a2 2 0 01-2-2V7m2 13a2 2 0 002-2V9.5a2.5 2.5 0 00-2.5-2.5H14">
                  </path>
                </svg>
                <span class="font-bold">Unified Feed</span>
              </a>
              <a href="/logout"
                class="flex items-center gap-3 px-4 py-3 text-zinc-500 hover:text-red-400 hover:bg-white/5 rounded-2xl transition-all">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                    d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1">
                  </path>
                </svg>
                Sign Out
              </a>
            </div>
          </aside>

          <!-- Right Column: Feed & Composer (lg:col-span-8) -->
          <section class="lg:col-span-8 space-y-8">
            <!-- Modern Composer -->
            <div class="glass rounded-[40px] p-8">
              <form method="POST" action="/posts" class="space-y-6">
                <div class="flex gap-5">
                  <img src="/images/uploads/<%= (user && user.profilepic) ? user.profilepic : 'default.jpg' %>"
                    alt="Avatar" class="w-14 h-14 rounded-2xl object-cover shadow-lg border border-white/5" />
                  <textarea name="content"
                    placeholder="What's happening, <%= user.name ? user.name.split(' ')[0] : 'there' %>?"
                    class="w-full bg-transparent text-white placeholder:text-zinc-700 outline-none resize-none text-xl mt-2 min-h-[80px] font-medium leading-relaxed"
                    required></textarea>
                </div>
                <div class="pt-6 border-t border-white/5 flex justify-between items-center">
                  <div class="flex gap-2">
                    <button type="button"
                      class="p-3 text-zinc-600 hover:text-blue-500 hover:bg-blue-500/10 rounded-2xl transition-all">
                      <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                          d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z">
                        </path>
                      </svg>
                    </button>
                  </div>
                  <button type="submit"
                    class="bg-blue-600 hover:bg-blue-500 text-white font-bold px-10 py-3.5 rounded-2xl transition-all shadow-xl shadow-blue-600/30 active:scale-[0.98] transform uppercase tracking-widest text-xs">
                    Post Everywhere
                  </button>
                </div>
              </form>
            </div>

            <div class="space-y-6">
              <header class="flex items-center justify-between px-4 pb-2">
                <h2 class="text-2xl font-bold text-white tracking-tight flex items-center gap-3">
                  Unified Feed
                  <span
                    class="text-[10px] bg-white/5 text-zinc-600 px-3 py-1 rounded-full border border-white/5">Auto-updating</span>
                </h2>
              </header>

              <!-- Timeline: Showing All Posts (Global Feed) -->
              <% if (typeof allPosts !=='undefined' && allPosts.length> 0) { %>
                <div class="space-y-6">
                  <% allPosts.forEach(function(p) { const currUid=String(user.userid || user._id || '' ); const
                    likedByUser=(p.likes || []).map(String).includes(currUid); const postAuthor=p.user || {}; const
                    isOwnPost=String(postAuthor._id)===currUid; %>
                    <article
                      class="glass rounded-[32px] p-8 group transition-all duration-500 hover:border-blue-500/30 hover:shadow-2xl hover:shadow-blue-900/10">
                      <header class="flex items-center justify-between mb-6">
                        <div class="flex items-center gap-4">
                          <img src="/images/uploads/<%= postAuthor.profilepic || 'default.jpg' %>" alt="Avatar"
                            class="w-12 h-12 rounded-2xl object-cover ring-4 ring-[#0b0c10] shadow-xl group-hover:ring-blue-500/10 transition-all" />
                          <div>
                            <h3
                              class="text-white font-bold text-lg leading-none group-hover:text-blue-400 transition-colors">
                              <%= postAuthor.name || postAuthor.username || 'Anonymous' %>
                                <% if(isOwnPost) { %><span
                                    class="ml-2 text-[8px] bg-blue-600/20 text-blue-400 px-1.5 py-0.5 rounded font-black uppercase tracking-widest">You</span>
                                  <% } %>
                            </h3>
                            <time class="text-[10px] text-zinc-600 uppercase tracking-widest font-black mt-1.5 block">
                              • <%= p.createdAt ? new Date(p.createdAt).toLocaleString(undefined, {month: 'short' ,
                                day: 'numeric' , hour: '2-digit' , minute:'2-digit'}) : 'Recently' %>
                            </time>
                          </div>
                        </div>

                        <% if(isOwnPost) { %>
                          <div class="flex gap-1.5 transition-all">
                            <a href="/posts/<%= p._id %>/edit"
                              class="p-2.5 text-zinc-500 hover:text-yellow-500 hover:bg-yellow-500/10 rounded-2xl transition-all border border-white/5 hover:border-yellow-500/20">
                              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                  d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z">
                                </path>
                              </svg>
                            </a>
                            <a href="/delete/<%= p._id %>" onclick="return confirm('Archive this publication?')"
                              class="p-2.5 text-zinc-500 hover:text-red-500 hover:bg-red-500/10 rounded-2xl transition-all border border-white/5 hover:border-red-500/20">
                              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                  d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 2 0 00-1 1v3M4 7h16">
                                </path>
                              </svg>
                            </a>
                          </div>
                          <% } %>
                      </header>

                      <p class="text-zinc-200 text-xl leading-relaxed mb-8 whitespace-pre-wrap font-medium">
                        <%= p.content %>
                      </p>

                      <div class="flex items-center gap-10 pt-6 border-t border-white/5">
                        <a href="/like/<%= p._id %>" class="flex items-center gap-3 group/like">
                          <div
                            class="<%= likedByUser ? 'bg-red-500 text-white shadow-lg shadow-red-500/40 scale-110' : 'text-zinc-600 hover:bg-red-500/10 hover:text-red-500' %> p-3 rounded-2xl transition-all duration-300">
                            <svg class="w-6 h-6 <%= likedByUser ? 'fill-current' : '' %>" fill="none"
                              stroke="currentColor" viewBox="0 0 24 24">
                              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z">
                              </path>
                            </svg>
                          </div>
                          <span class="<%= likedByUser ? 'text-white' : 'text-zinc-600' %> text-base font-black">
                            <%= (p.likes && p.likes.length) || 0 %>
                          </span>
                        </a>
                      </div>
                    </article>
                    <% }) %>
                </div>
                <% } else { %>
                  <div class="glass rounded-[40px] p-24 text-center">
                    <div
                      class="w-24 h-24 bg-white/5 mx-auto rounded-3xl flex items-center justify-center mb-8 border border-white/5 shadow-2xl">
                      <svg class="w-12 h-12 text-zinc-700" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                          d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10">
                        </path>
                      </svg>
                    </div>
                    <h3 class="text-white font-black text-2xl mb-4">The Feed is Empty</h3>
                    <p class="text-zinc-500 text-lg max-w-sm mx-auto leading-relaxed">Be the first to spark a
                      conversation on SocialNode.</p>
                  </div>
                  <% } %>
            </div>
          </section>

        </div>
      </main>
  </body>

</html>