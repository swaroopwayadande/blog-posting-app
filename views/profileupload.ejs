<!DOCTYPE html>
<html lang="en">
<%- include('partials/head', {title: 'Customize Profile – SocialNode' }) %>

  <body class="bg-[#0b0c10] text-[#c5c6c7] antialiased">

    <%- include('partials/navbar') %>

      <main class="min-h-[calc(100vh-64px)] w-full flex items-center justify-center p-6 relative">
        <div class="absolute inset-0 bg-indigo-600/5 pointer-events-none"></div>

        <div class="w-full max-w-md glass rounded-[40px] p-10 relative z-10 shadow-2xl overflow-hidden text-center">
          <div class="absolute top-0 right-0 w-32 h-32 bg-blue-600/10 blur-[80px] -mr-16 -mt-16"></div>

          <header class="mb-10 relative">
            <div
              class="w-24 h-24 bg-gradient-to-tr from-blue-600 to-indigo-600 rounded-3xl mx-auto mb-6 flex items-center justify-center shadow-xl shadow-blue-500/20">
              <svg class="w-12 h-12 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                  d="M3 9a2 2 0 012-2h.93a2 2 0 001.664-.89l.812-1.22A2 2 0 0110.07 4h3.86a2 2 0 011.664.89l.812 1.22A2 2 0 0018.07 7H19a2 2 0 012 2v9a2 2 0 01-2 2H5a2 2 0 01-2-2V9z">
                </path>
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                  d="M15 13a3 3 0 11-6 0 3 3 0 016 0z"></path>
              </svg>
            </div>
            <h1 class="text-3xl font-bold text-white tracking-tight">Vibe Upgrade</h1>
            <p class="text-zinc-500 font-medium mt-2">Upload a new face for SocialNode.</p>
          </header>

          <form action="/upload" method="post" enctype="multipart/form-data" class="space-y-8">
            <div
              class="group relative bg-[#050505]/50 border-2 border-dashed border-white/10 hover:border-blue-500/40 rounded-3xl p-8 transition-all cursor-pointer">
              <input type="file" name="image" id="image-upload" required
                class="absolute inset-0 opacity-0 cursor-pointer z-10"
                onchange="document.getElementById('file-name').innerText = this.files[0].name" />
              <div class="relative z-0">
                <svg class="w-10 h-10 text-zinc-600 mx-auto mb-3 group-hover:text-blue-500 transition-colors"
                  fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                    d="M7 16a4 4 0 01-.88-7.903A5 5 0 1115.9 6L16 6a5 5 0 011 9.9M15 13l-3-3m0 0l-3 3m3-3v12"></path>
                </svg>
                <p id="file-name" class="text-sm font-bold text-zinc-500 group-hover:text-white transition-colors">
                  Choose an image...</p>
                <p class="text-[10px] text-zinc-600 font-extrabold uppercase tracking-widest mt-2">JPG • PNG • GIF</p>
              </div>
            </div>

            <div class="flex flex-col gap-4">
              <button type="submit"
                class="w-full bg-blue-600 hover:bg-blue-500 text-white font-bold py-4 rounded-2xl transition-all shadow-lg shadow-blue-500/20 active:scale-[0.98]">
                Update Avatar
              </button>
              <a href="/profile"
                class="text-[10px] font-bold text-zinc-600 hover:text-white uppercase tracking-[0.2em] transition-colors">
                Maybe Later
              </a>
            </div>
          </form>
        </div>
      </main>
  </body>

</html>