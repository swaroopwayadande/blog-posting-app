<!DOCTYPE html>
<html lang="en">
<%- include('partials/head', {title: 'Edit Post – SocialNode' }) %>

  <body class="bg-[#0b0c10] text-[#c5c6c7] antialiased">

    <%- include('partials/navbar') %>

      <main class="min-h-[calc(100vh-64px)] w-full flex items-center justify-center p-6 relative">
        <div class="absolute inset-0 bg-blue-600/5 pointer-events-none"></div>

        <div class="w-full max-w-xl glass rounded-[40px] p-10 relative z-10 shadow-2xl">
          <header class="mb-8">
            <div class="flex items-center gap-3 mb-2">
              <div class="p-2 bg-yellow-500/10 rounded-xl text-yellow-500">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                    d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z">
                  </path>
                </svg>
              </div>
              <h1 class="text-3xl font-bold text-white tracking-tight">Refine Your Thought</h1>
            </div>
            <p class="text-zinc-500 font-medium">Updating this post will change it across all feeds.</p>
          </header>

          <form method="post" action="/update/<%= post._id %>" class="space-y-8">
            <div class="relative">
              <textarea name="content" rows="8"
                class="w-full bg-[#050505]/50 border border-white/5 focus:border-blue-500/50 focus:ring-4 focus:ring-blue-500/5 rounded-3xl p-6 text-white text-lg outline-none transition-all placeholder:text-zinc-700 resize-none font-medium leading-relaxed"
                placeholder="What's the revised version?..." required><%= post.content %></textarea>
            </div>

            <div class="flex items-center gap-4 pt-4">
              <button type="submit"
                class="flex-1 bg-blue-600 hover:bg-blue-500 text-white font-bold py-4 rounded-2xl transition-all shadow-lg shadow-blue-500/20 active:scale-[0.98]">
                Update Post
              </button>
              <a href="/profile"
                class="flex-1 text-center bg-white/5 hover:bg-white/10 text-white font-bold py-4 rounded-2xl transition-all border border-white/5 uppercase tracking-widest text-xs">
                Discard Changes
              </a>
            </div>
          </form>
        </div>
      </main>
  </body>

</html>