<!DOCTYPE html>
<html lang="en">
<%- include('partials/head', {title: 'Log In – SocialNode' }) %>

  <body class="bg-[#050505] text-white antialiased selection:bg-blue-500/30">
    <main class="min-h-screen w-full flex items-center justify-center p-6 relative overflow-hidden">
      <div
        class="absolute inset-0 bg-gradient-to-tr from-blue-900/10 via-zinc-950 to-indigo-900/10 pointer-events-none">
      </div>

      <section class="w-full max-w-md relative z-10">
        <div class="flex justify-center mb-8">
          <div class="bg-blue-600/10 p-3 rounded-2xl border border-blue-500/20">
            <svg class="w-10 h-10 text-blue-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                d="M11 16l-4-4m0 0l4-4m-4 4h14m-5 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h7a3 3 0 013 3v1"></path>
            </svg>
          </div>
        </div>

        <header class="mb-10 text-center">
          <h1 class="text-3xl font-bold tracking-tight">Welcome Back</h1>
          <p class="text-zinc-500 mt-2">Enter your SocialNode credentials.</p>
        </header>

        <form action="/login" method="post"
          class="bg-zinc-900/50 backdrop-blur-xl border border-white/5 rounded-3xl p-8 space-y-6 shadow-2xl shadow-black/50">
          <div class="space-y-4">
            <div class="space-y-2">
              <label for="username"
                class="text-xs font-bold text-zinc-500 uppercase tracking-widest ml-1">Username</label>
              <input id="username" name="username" type="text" placeholder="johndoe" required
                class="w-full bg-zinc-950 border border-zinc-800 focus:border-blue-500 focus:ring-4 focus:ring-blue-500/10 rounded-xl px-4 py-3.5 outline-none transition-all placeholder:text-zinc-600" />
            </div>

            <div class="space-y-2">
              <div class="flex items-center justify-between ml-1">
                <label for="password" class="text-xs font-bold text-zinc-500 uppercase tracking-widest">Password</label>
                <a href="#"
                  class="text-[10px] text-blue-500 font-bold uppercase tracking-widest hover:text-blue-400">Forgot?</a>
              </div>
              <input id="password" name="password" type="password" placeholder="••••••••" required
                class="w-full bg-zinc-950 border border-zinc-800 focus:border-blue-500 focus:ring-4 focus:ring-blue-500/10 rounded-xl px-4 py-3.5 outline-none transition-all placeholder:text-zinc-600" />
            </div>
          </div>

          <div class="flex items-center gap-2 px-1">
            <input id="remember" name="remember" type="checkbox"
              class="size-4 accent-blue-500 rounded border-zinc-800 bg-zinc-950" />
            <label for="remember" class="text-xs text-zinc-400 select-none">Keep me signed in</label>
          </div>

          <button type="submit"
            class="w-full bg-blue-600 hover:bg-blue-500 active:scale-[0.98] text-white font-bold py-4 rounded-xl transition-all shadow-lg shadow-blue-500/20">
            Sign In
          </button>
        </form>

        <footer class="mt-8 text-center text-sm">
          <p class="text-zinc-500">
            New to SocialNode? <a href="/" class="text-blue-500 font-bold hover:underline">Join Now</a>
          </p>
        </footer>
      </section>
    </main>
  </body>

</html>